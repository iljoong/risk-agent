# Copy to .env at the project root. Foundry models use Azure identity, not API keys.
# Replace endpoints and deployment names with your actual Microsoft Foundry deployments.
# IDs are app identifiers. Deployment names are your own Azure deployment names.
APP_MODELS=[{"id":"foundry-openai","label":"Foundry OpenAI","provider":"openai","endpoint":"https://YOUR-RESOURCE.openai.azure.com/openai/v1/","deployment":"YOUR-OPENAI-DEPLOYMENT","wire_api":"responses","scope":"https://ai.azure.com/.default","context_budget_tokens":32000},{"id":"foundry-claude","label":"Foundry Claude","provider":"anthropic","endpoint":"https://YOUR-RESOURCE.services.ai.azure.com/anthropic","deployment":"YOUR-CLAUDE-DEPLOYMENT","scope":"https://ai.azure.com/.default","context_budget_tokens":32000}]
APP_DEFAULT_MODEL_ID=foundry-openai
APP_HOST=127.0.0.1
APP_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Optional exact additional origin for temporary, IP-restricted remote testing.
# Keep the API on loopback; this does not add authentication or HTTPS.
# APP_REMOTE_FRONTEND_ORIGIN=http://YOUR-VM-PUBLIC-IP:5173
# Local development: use the account signed in with az login instead of the VM's managed identity.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential
# APP_DATA_DIR=C:\absolute\path\to\local-data
# APP_FOREGROUND_TIMEOUT_SECONDS=120
# APP_BACKGROUND_TIMEOUT_SECONDS=1800
# APP_CLASSIFIER_TIMEOUT_SECONDS=5
# APP_UPLOAD_LIMIT_BYTES=26214400
# APP_PDF_PAGE_LIMIT=500
# APP_PDF_CHARACTER_LIMIT=2000000
# APP_PDF_TIMEOUT_SECONDS=30
# Optional Microsoft Web IQ web/news search (requires Web IQ access).
# Server-only key; never put it in frontend/VITE variables. Restart API and worker after changing.
# WEBIQ_API_KEY=YOUR-WEBIQ-API-KEY
